# ============================================================================
# .env.production.local — Environment template for local production
# ============================================================================
# Copy this file to .env.local and adjust values as needed:
#   cp .env.production.local .env.local
#   docker compose -f docker-compose.local-prod.yml up --build
# ============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=perokio

# ── JWT ──────────────────────────────────────────────────────────────────────
# ⚠️ CHANGE THIS IN PRODUCTION — generate with: openssl rand -hex 32
JWT_SECRET=perokio-dev-secret-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Cloudflare R2 (mocked in V1 — replace with real keys for production) ────
R2_ACCOUNT_ID=dev
R2_ACCESS_KEY_ID=dev
R2_SECRET_ACCESS_KEY=dev
R2_BUCKET=perokio-videos-dev

# ── Frontend ─────────────────────────────────────────────────────────────────
# The URL the browser uses to reach the API (baked into the Next.js build)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Production-only (not used in local-prod, but documented for reference) ──
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# POSTIZ_API_KEY=xxx
# POSTIZ_API_URL=https://api.postiz.com
# FLOUCI_API_KEY=xxx
# FLOUCI_API_SECRET=xxx
# OPENROUTER_API_KEY=sk-or-xxx
