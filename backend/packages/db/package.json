{
  "name": "@perokio/db",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma --name init",
    "prisma:push": "prisma db push --schema prisma/schema.prisma --force-reset --accept-data-loss",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "seed": "ts-node src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  },
  "devDependencies": {
    "prisma": "^6.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
